# Docker Compose reads this file. See DEPLOY.md for configuration defaults.
NODE_ENV=production
HOST=0.0.0.0
PORT=3100
LNKZ_PUBLIC_BASE_URL=http://localhost:3100
ALLOWED_HOSTS=localhost,127.0.0.1
ALLOWED_ORIGINS=http://localhost:3100
LNKZ_MCP_API_KEY_REQUIRED=true
# Generate LNKZ_API_KEY using the command in DEPLOY.md before starting.
