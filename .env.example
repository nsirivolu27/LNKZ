# Server
HOST=0.0.0.0
PORT=3100
LNKZ_PUBLIC_BASE_URL=http://localhost:3100
ALLOWED_HOSTS=localhost,127.0.0.1
ALLOWED_ORIGINS=http://localhost:3100

# Authentication. Required in production.
LNKZ_API_KEY=replace-with-a-long-random-secret
LNKZ_MCP_API_KEY_REQUIRED=true
# LNKZ_ALLOW_UNAUTHENTICATED=true is intended only for local development.

# Storage. Omit DATABASE_URL to use SQLite at .data/lnkz.db.
# DATABASE_URL=postgresql://user:password@localhost:5432/lnkz
# DATABASE_SSL=false
# LNKZ_DATABASE_APP_ROLE=lnkz_app

# Optional multi-workspace static principals. Requires Postgres.
# LNKZ_AUTH_MODE=multi-key
# LNKZ_API_KEYS_JSON=[{"key":"...","workspaceId":"00000000-0000-4000-8000-000000000001","actorId":"system","scopes":["mcp","read","write"]}]
