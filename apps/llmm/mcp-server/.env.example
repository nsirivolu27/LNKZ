HOST=127.0.0.1
PORT=3100
LNKZ_API_KEY=change-me
LNKZ_PUBLIC_BASE_URL=http://localhost:3100
LNKZ_DB_FILE=.data/lnkz.db
# Set DATABASE_URL to use Postgres; SQLite remains the default when it is blank.
DATABASE_URL=
# App Runner can inject this JSON secret instead of DATABASE_URL. When used,
# DATABASE_HOST/PORT/NAME supply the non-secret endpoint fields.
DATABASE_SECRET_JSON=
DATABASE_HOST=
DATABASE_PORT=5432
DATABASE_NAME=lnkz
DATABASE_SSL=false
LNKZ_POSTGRES_WORKSPACE_ID=00000000-0000-4000-8000-000000000001
LNKZ_DATABASE_APP_ROLE=
# Per-App Runner instance pool budget. Keep the default low for db.t4g.micro.
LNKZ_PG_POOL_MAX=8
LNKZ_PG_IDLE_TIMEOUT_MS=30000
LNKZ_PG_CONNECTION_TIMEOUT_MS=5000
LNKZ_PG_MAX_LIFETIME_SECONDS=300
# Only read once, to migrate a pre-SQLite install:
LNKZ_DATA_FILE=.data/lnkz.json
ALLOWED_HOSTS=localhost,127.0.0.1
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3100

# Slack: a user token enables workspace search. A bot token is limited to the listed channels.
SLACK_USER_TOKEN=
SLACK_BOT_TOKEN=
SLACK_CHANNEL_IDS=

# Jira Cloud
JIRA_BASE_URL=
JIRA_EMAIL=
JIRA_API_TOKEN=

# Figma
FIGMA_PERSONAL_ACCESS_TOKEN=
FIGMA_ACCESS_TOKEN=
FIGMA_FILE_KEYS=

# Normalized JSON document feeds
DOCUMENT_FEED_URLS=
DOCUMENT_FEED_BEARER_TOKEN=

# Downstream MCP servers LNKZ can prepare context for, as name=url or name=url|key.
# Discovery and payload preparation only: LNKZ never calls a remote write tool.
LNKZ_MCP_TARGETS=

# Fantasy Copilot's Streamable HTTP MCP endpoint
FANTASY_MCP_URL=
FANTASY_MCP_API_KEY=

# Request budgets per minute per client IP. Set to 0 to disable.
LNKZ_SHARE_RATE_LIMIT=60
LNKZ_API_RATE_LIMIT=600
