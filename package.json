{
  "name": "workspace",
  "version": "0.0.0",
  "license": "MIT",
  "packageManager": "pnpm@10.26.1",
  "scripts": {
    "preinstall": "sh -c 'rm -f package-lock.json yarn.lock; case \"$npm_config_user_agent\" in pnpm/*) ;; *) echo \"Use pnpm instead\" >&2; exit 1 ;; esac'",
    "build": "pnpm run typecheck && pnpm --filter @workspace/api-server build",
    "typecheck:libs": "tsc --build",
    "typecheck": "pnpm run typecheck:libs && pnpm -r --filter @workspace/api-server --filter @workspace/mobile --filter ./scripts --if-present run typecheck",
    "test": "pnpm --filter @workspace/api-server test && pnpm --filter @workspace/mobile test",
    "build:mobile": "pnpm --filter @workspace/mobile build",
    "codegen": "pnpm --filter @workspace/api-spec codegen",
    "verify:api": "pnpm --filter @workspace/api-server typecheck && pnpm --filter @workspace/api-server test",
    "verify:mobile": "pnpm --filter @workspace/mobile typecheck && pnpm --filter @workspace/mobile test"
  },
  "private": true,
  "pnpm": {
    "overrides": {
      "brace-expansion": "5.0.9",
      "esbuild": "0.28.2",
      "fast-uri": "3.1.6",
      "js-yaml": "4.3.1",
      "nanoid": "3.3.18",
      "qs": "6.16.0"
    }
  },
  "dependencies": {
    "@replit/connectors-sdk": "^0.4.1"
  },
  "devDependencies": {
    "prettier": "^3.9.6",
    "typescript": "~5.9.3"
  }
}
