{
  "name": "lnkz",
  "version": "0.2.0",
  "description": "LNKZ conversation relay workflow: move useful context between LLMs, apps, devices, and people.",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.26.1",
  "scripts": {
    "dev": "pnpm run build && pnpm run start",
    "build": "node ./build.mjs",
    "start": "node --enable-source-maps ./dist/index.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "db:migrate": "node --enable-source-maps ./dist/lnkz/store/migrate.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "express": "^5.1.0",
    "pg": "^8.23.0",
    "zod": "^3.25.28"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/node": "^25.3.3",
    "@types/pg": "^8.15.5",
    "esbuild": "^0.27.3",
    "typescript": "^5.9.3"
  },
  "pnpm": {
    "overrides": {
      "brace-expansion": "5.0.9",
      "esbuild": "0.28.2",
      "fast-uri": "3.1.6",
      "js-yaml": "4.3.1",
      "nanoid": "3.3.18",
      "qs": "6.16.0"
    }
  }
}
