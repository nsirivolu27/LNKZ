{
  "name": "lnkz",
  "version": "0.2.0",
  "description": "LNKZ conversation relay workflow: move useful context between LLMs, apps, devices, and people.",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.26.1",
  "scripts": {
    "dev": "pnpm run build && pnpm run start",
    "build": "pnpm build:relay && pnpm build:web",
    "build:relay": "node ./build.mjs",
    "build:web": "pnpm --filter @lnkz/web build",
    "dev:web": "pnpm --filter @lnkz/web dev",
    "infra:synth": "pnpm --filter @lnkz/infra synth",
    "test": "tsc -p tsconfig.test.json && node scripts/copy-test-migrations.mjs && node --test .testbuild/tests/*.test.js",
    "verify:http": "node ./scripts/verify-http.mjs",
    "verify:web": "node ./scripts/verify-web.mjs",
    "smoke": "node ./scripts/smoke.mjs",
    "db:backup": "node ./scripts/backup-sqlite.mjs",
    "start": "node --enable-source-maps ./dist/index.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit && pnpm --filter @lnkz/web typecheck && pnpm --filter @lnkz/infra typecheck",
    "db:migrate": "node --enable-source-maps ./dist/lnkz/store/migrate.mjs",
    "seed": "node ./scripts/seed.mjs",
    "ask": "node ./scripts/ask.mjs",
    "demo": "node ./scripts/demo.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "express": "^5.1.0",
    "pg": "^8.23.0",
    "zod": "^3.25.28"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/node": "^25.3.3",
    "@types/pg": "^8.15.5",
    "esbuild": "^0.27.3",
    "typescript": "^5.9.3"
  },
  "pnpm": {
    "overrides": {
      "brace-expansion": "5.0.9",
      "esbuild": "0.28.2",
      "fast-uri": "3.1.6",
      "js-yaml": "4.3.1",
      "nanoid": "3.3.18",
      "qs": "6.16.0"
    }
  }
}
